# Minimal image for the Docker Pandas executor: pandas + numpy + the standalone worker only.
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PIP_NO_CACHE_DIR=1
RUN pip install pandas numpy
COPY datasleuth/sandbox/pandas_worker.py /app/pandas_worker.py
USER 65534:65534
WORKDIR /tmp
# Run by the API as: docker run --rm -i --network none --read-only --user 65534 ... python -I /app/pandas_worker.py
CMD ["python", "-I", "/app/pandas_worker.py"]
