# Copy to .env and fill in. Gemini free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional alternatives
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_HOST=http://localhost:11434

DATASLEUTH_LLM_PROVIDER=gemini
DATASLEUTH_LLM_MODEL=gemini-3.1-flash-lite
# Free tier is rate limited: stay under the RPM and cap uncached calls per day.
DATASLEUTH_LLM_RPM=10
DATASLEUTH_LLM_DAILY_LIMIT=200
# DATASLEUTH_LANGSMITH: set LANGSMITH_API_KEY / LANGSMITH_TRACING=true for optional tracing
